# API Keys (至少配置一个)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# LLM 默认配置
SCIFORGE_LLM_PROVIDER=anthropic
SCIFORGE_LLM_MODEL=claude-sonnet-4-20250514
# SCIFORGE_LLM_BASE_URL=https://your-relay.example.com/v1
# SCIFORGE_LLM_REASONING_EFFORT=high

# Pipeline
SCIFORGE_MAX_CONCURRENT_LLM_CALLS=3
SCIFORGE_GENERATION_MAX_ROUNDS=3

# 日志
SCIFORGE_LOG_LEVEL=INFO
SCIFORGE_LOG_FORMAT=console
