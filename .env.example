# API Keys (至少配置一个)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# LLM 默认配置
MATHFORGE_LLM_PROVIDER=anthropic
MATHFORGE_LLM_MODEL=claude-sonnet-4-20250514
# MATHFORGE_LLM_BASE_URL=https://your-relay.example.com/v1
# MATHFORGE_LLM_REASONING_EFFORT=high

# Pipeline
MATHFORGE_MAX_CONCURRENT_LLM_CALLS=3
MATHFORGE_GENERATION_MAX_ROUNDS=3

# 日志
MATHFORGE_LOG_LEVEL=INFO
MATHFORGE_LOG_FORMAT=console
