# =============================================================================
# SciForge 环境变量模板
# -----------------------------------------------------------------------------
# 用法:
#   1. cp .env.example .env
#   2. 填入你实际使用的 API Key（不用的平台可以删或留空）
#   3. config/sciforge.toml 里的 ${VAR_NAME} 占位符会自动从这里解析
#
# 优先级链（高 → 低）:
#   CLI flag
#   > SCIFORGE_TASK_<TASK>_<FIELD> 环境变量
#   > config/sciforge.toml 里的 [tasks.<task>] 字段
#   > config/sciforge.toml 里的 [providers.<ref>] 字段（含 ${VAR} 插值）
#   > LLMConfig.PRESETS[task]
#   > 代码默认值
# =============================================================================


# ── 各平台 API Key (按需填写) ────────────────────────────────
#
# 被 config/sciforge.toml 的 ${VAR} 占位符引用。对应关系:
#   anthropic_official → ANTHROPIC_API_KEY
#   openai_official    → OPENAI_API_KEY
#   gemini_official    → GOOGLE_API_KEY
#   openrouter         → OPENROUTER_API_KEY
#   zai_anthropic      → ZAI_API_KEY
#   deepseek_anthropic → DEEPSEEK_API_KEY
#   ollama_local       → 无需 (使用 "dummy")

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
GOOGLE_API_KEY=...
OPENROUTER_API_KEY=sk-or-v1-...
ZAI_API_KEY=...
DEEPSEEK_API_KEY=sk-...
MINIMAX_API_KEY=sk-...

# ── SciForge 全局开关 ────────────────────────────────────────

# 默认 TOML 配置文件路径（不设则自动找 config/sciforge.toml）
# SCIFORGE_LLM_CONFIG_FILE=config/sciforge.toml

# 日志级别与格式
SCIFORGE_LOG_LEVEL=INFO
SCIFORGE_LOG_FORMAT=console


# ── 可选：针对单个 task 的临时覆写 ───────────────────────────
#
# 格式: SCIFORGE_TASK_<TASK_NAME>_<FIELD>
# 优先级最高，会覆盖 TOML 里的 [tasks.<task>] 设置。
#
# 示例:
#   SCIFORGE_TASK_GENERATE_MODEL=claude-opus-4-20250805
#   SCIFORGE_TASK_SOLVE_TEMPERATURE=0.0
#   SCIFORGE_TASK_VLM_CONVERT_MAX_TOKENS=16384
#   SCIFORGE_TASK_EXTRACT_AND_CLASSIFY_PROVIDER_REF=anthropic_official
